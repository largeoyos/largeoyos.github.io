+    $('btnConfirmMatrix').addEventListener('click', () => {
+        try {
+            const name = validateMatrixName(matrixName.value || 'M');
+            if (matrixStore[name]) throw new Error(`矩阵 ${name} 已存在，请使用新名称。`);
+            const matrix = readGrid();
+            addMatrix(name, matrix);
+            closeDefineModal();
+        } catch (error) {
+            modalFeedback.textContent = error.message;
+        }
+    });
