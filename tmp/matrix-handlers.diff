+    $('btnResize').addEventListener('click', () => {
+        try {
+            const { rows, cols } = getGridSize();
+            const oldData = {};
+            matrixGrid.querySelectorAll('input').forEach(input => {
+                oldData[input.dataset.r + ',' + input.dataset.c] = input.value;
+            });
+            buildGrid(rows, cols);
+            matrixGrid.querySelectorAll('input').forEach(input => {
+                const key = input.dataset.r + ',' + input.dataset.c;
+                if (oldData[key] !== undefined) input.value = oldData[key];
+            });
+            modalFeedback.textContent = '';
+        } catch (error) {
+            modalFeedback.textContent = error.message;
+        }
+    });
+
+    $('btnIdentity').addEventListener('click', () => {
+        try {
+            const { rows, cols } = getGridSize();
+            buildGrid(rows, cols);
+            modalFeedback.textContent = '';
+        } catch (error) {
+            modalFeedback.textContent = error.message;
+        }
+    });
+
+    $('btnClearGrid').addEventListener('click', () => {
+        matrixGrid.querySelectorAll('input').forEach(input => { input.value = ''; });
+        modalFeedback.textContent = '';
+    });
