+    function replaceSelectOptions(select, names, previousValue) {
+        select.replaceChildren(...names.map(name => {
+            const option = document.createElement('option');
+            option.value = name;
+            option.textContent = name;
+            return option;
+        }));
+        if (names.includes(previousValue)) select.value = previousValue;
+    }
+
+    function refreshSelects() {
+        const names = Object.keys(matrixStore);
+        const aVal = selectA.value;
+        const bVal = selectB.value;
+        replaceSelectOptions(selectA, names, aVal);
+        replaceSelectOptions(selectB, names, bVal);
+    }
+
+    function dataPreview(data) {
+        try {
+            return data.map(row =>
+                row.map(c => {
+                    const s = nerdamer(escE(c)).toString();
+                    return unescE(s.length > 10 ? s.slice(0, 10) + '…' : s);
+                }).join(' ')
+            ).join(' \\ ');
+        } catch (e) { return ''; }
+    }
+
+    function setActiveWarehouseItem(name) {
+        document.querySelectorAll('.matrix-item').forEach(item => {
+            item.classList.toggle('active', item.dataset.name === name);
+        });
+    }
+
+    function selectMatrix(name) {
+        const data = matrixStore[name];
+        if (!data) return;
+        currentResult = data;
+        currentResultType = 'matrix';
+        _numericNote = '';
+        renderCurrentResult();
+        setActiveWarehouseItem(name);
+    }
